{
  "components": {
    "schemas": {
      "Action": {
        "description": "What a client may do with one open decision.",
        "enum": [
          "merge",
          "keep_distinct",
          "skip",
          "relate",
          "relate_reversed",
          "set_tier"
        ],
        "title": "Action",
        "type": "string"
      },
      "ActivityEntry": {
        "description": "One `log.md` bullet: its section date and its text.",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "date",
          "text"
        ],
        "title": "ActivityEntry",
        "type": "object"
      },
      "Applied": {
        "additionalProperties": false,
        "description": "The action took effect. `commit_sha` is `None` when the auto-commit\ndegraded (the write itself still landed). `committed_confidential` is true\nonly when a commit landed and holds a concept explicitly marked\n`sensitivity: confidential`; an adapter that has no notice of its own to\nprint leaves it false, and one that reports it sets it from the commit's\noutcome.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "committed_confidential": {
            "default": false,
            "title": "Committed Confidential",
            "type": "boolean"
          },
          "decision_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Key"
          }
        },
        "required": [
          "decision_key",
          "action",
          "commit_sha"
        ],
        "title": "Applied",
        "type": "object"
      },
      "ApplyRequest": {
        "description": "The action, the version the preview issued (echoed unchanged) and how\nlong to wait for the workspace lock; a client can shorten the wait only.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "version": {
            "$ref": "#/components/schemas/DecisionVersion"
          },
          "wait_seconds": {
            "default": 5.0,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Wait Seconds",
            "type": "number"
          }
        },
        "required": [
          "action",
          "version"
        ],
        "title": "ApplyRequest",
        "type": "object"
      },
      "ApplyResponse": {
        "additionalProperties": false,
        "description": "What was applied, and the warnings the apply raised along the way (for\nexample a commit that could not be made).",
        "properties": {
          "applied": {
            "$ref": "#/components/schemas/Applied"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "applied",
          "warnings"
        ],
        "title": "ApplyResponse",
        "type": "object"
      },
      "Decision": {
        "additionalProperties": false,
        "description": "One open decision, as data a client can render.",
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "title": "Actions",
            "type": "array"
          },
          "decision_key": {
            "title": "Decision Key",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IdentityDetail"
              },
              {
                "$ref": "#/components/schemas/RelationDetail"
              },
              {
                "$ref": "#/components/schemas/TierDetail"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "evaluation": {
            "enum": [
              "judged_same",
              "judged_different",
              "judged_uncertain",
              "pending_evaluation",
              "not_applicable"
            ],
            "title": "Evaluation",
            "type": "string"
          },
          "fresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fresh"
          },
          "kind": {
            "enum": [
              "identity",
              "relation_type",
              "volatility",
              "contradiction",
              "revision",
              "watch_refusal"
            ],
            "title": "Kind",
            "type": "string"
          },
          "resolves_via": {
            "title": "Resolves Via",
            "type": "string"
          },
          "targets": {
            "items": {
              "type": "string"
            },
            "title": "Targets",
            "type": "array"
          },
          "withheld": {
            "items": {
              "$ref": "#/components/schemas/WithheldAction"
            },
            "title": "Withheld",
            "type": "array"
          }
        },
        "required": [
          "decision_key",
          "kind",
          "targets",
          "fresh",
          "evaluation",
          "actions",
          "withheld",
          "resolves_via",
          "detail"
        ],
        "title": "Decision",
        "type": "object"
      },
      "DecisionList": {
        "additionalProperties": false,
        "description": "Every open decision, in an envelope that leaves room for additive fields.",
        "properties": {
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "title": "Decisions",
            "type": "array"
          }
        },
        "required": [
          "decisions"
        ],
        "title": "DecisionList",
        "type": "object"
      },
      "DecisionPreview": {
        "description": "What an action would do, and the version to apply it against.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "decision_key": {
            "title": "Decision Key",
            "type": "string"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MergePlan"
              },
              {
                "$ref": "#/components/schemas/RelatePlan"
              },
              {
                "$ref": "#/components/schemas/TierPlan"
              },
              {
                "$ref": "#/components/schemas/KeepDistinctPlan"
              }
            ],
            "title": "Plan"
          },
          "version": {
            "$ref": "#/components/schemas/DecisionVersion"
          }
        },
        "required": [
          "decision_key",
          "action",
          "plan",
          "version"
        ],
        "title": "DecisionPreview",
        "type": "object"
      },
      "DecisionVersion": {
        "description": "The version a stateless caller commits against.\n\n`payload_digest` proves the queue row, its proposal and its recorded\ninputs are unchanged; `content_digest` proves the bytes the human saw are\nthe bytes that would be written. `payload_digest` is `None` when no queue\nrow backs the item, which the token path rejects. `decision_key` is the\nhandle: a findings row id is never used, because the cache is derived.",
        "properties": {
          "content_digest": {
            "title": "Content Digest",
            "type": "string"
          },
          "decision_key": {
            "title": "Decision Key",
            "type": "string"
          },
          "payload_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload Digest"
          }
        },
        "required": [
          "decision_key",
          "payload_digest",
          "content_digest"
        ],
        "title": "DecisionVersion",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "The one body shape of every non-2xx response.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "description": "The authenticated liveness answer.",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version",
          "engine_version"
        ],
        "title": "HealthBody",
        "type": "object"
      },
