          "staging_dropped",
          "below_source_sensitivity",
          "dangling_provenance",
          "unbacked_provenance",
          "exact_title_groups",
          "open_contradictions",
          "stale_contradictions"
        ],
        "title": "HealthCounts",
        "type": "object"
      },
      "IdentityDetail": {
        "additionalProperties": false,
        "description": "An identity decision: a group that may be one entity.",
