{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKOS",
  "version": "0.1.0",
  "identifier": "io.github.jasonssdev.openkos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenKOS",
        "width": 880,
        "height": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQjI0OUMxOUUxQ0FGOTkKUldTWnJ4eWV3VW15eXN6c1hlMXpFcGtEcDRSRW5FZmN5ZHIxUmlpVHN4UTJ4Q2ZGSWtVUlBXdkEK",
      "endpoints": ["https://github.com/jasonssdev/openkos/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
