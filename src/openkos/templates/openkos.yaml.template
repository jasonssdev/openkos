model: __OPENKOS_MODEL__  # local model served via Ollama; see tech_stack.md
embedding_model: __OPENKOS_EMBEDDING_MODEL__  # 1024-dim; changing it forces a full re-embed
review: true              # show proposed changes and confirm before saving
default_sensitivity: private
confidential_local_exemption: true  # send confidential concepts to a LOCAL LLM backend
freshness_window: 7d      # age after which a stamp is flagged for re-observation
chat_timeout: 600         # seconds an LLM chat call may take before giving up
max_generation_tokens: 8192  # safety rail: hard ceiling on tokens a chat call may generate
context_window: 12288     # tokens the model holds at once (prompt + reply); unpinned it
                          # reserves its own 32K default and ~10 GB. Refused below the
                          # derived floor; blank the value to leave it unpinned.
# volatility_windows:     # per-tier stale-stamp windows (overrides freshness_window
#   slow: 90d             # by knowledge-volatility tier; see docs/adr/0007)
#   volatile: 7d
# type_tiers:             # per-concept-type volatility tier overrides (overrides
#   Person: volatile      # the built-in registry default; see docs/adr/0007)
# type_sensitivity_defaults:  # per-type birth offset above `default_sensitivity`,
#   Person: 1             # in levels, clamped at confidential. Ships as
                          # `Person: 1`, so a Person is born one level above the
                          # floor; set to 0 to opt a type out. The high-water-mark
                          # over cited sources still wins whenever it is higher.
                          # See docs/adr/0015.
# models:                 # per-task model overrides. Every task follows
#   edge_typing: gemma2:27b  # `model:` by default, so nothing here needs a
                          # second `ollama pull`. gemma2:27b is the one
                          # measured upgrade: it names relations better
                          # (0.81 vs qwen3:8b's 0.44 on evals/edge_typing/)
                          # but costs `ollama pull gemma2:27b` -- 15.6 GB.
                          # Uncomment BOTH lines above to opt in; uncommenting
                          # only one is invalid YAML. Keep it scoped to
                          # edge_typing -- it is the worst extractor measured,
                          # so it must never become `model:`. `openkos doctor`
                          # reports whether it is installed.
                          # Only edge_typing has a harness; measure before
                          # adding a key. Valid tasks: extraction,
                          # adjudication, edge_typing, volatility_typing,
                          # contradiction.
# union_judge: true       # union-of-runs + selector-judge extraction (default
                          # on); set false to restore the single-run, single-cap
                          # extraction path byte-for-byte

# Layout is fixed: `raw/` (immutable sources) and `bundle/` (the OKF
# bundle root) live next to this file. The engine does not read layout
# keys from this config; making them configurable is future work.

# type_registry is maintained by the engine (canonical + emergent types)
